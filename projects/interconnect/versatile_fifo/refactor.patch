-module versatile_fifo_async_cmp ( wptr, rptr, fifo_empty, fifo_full, wclk, rclk, rst );
-
-   parameter ADDR_WIDTH = 4;   
-   parameter N = ADDR_WIDTH-1;
-
-   parameter Q1 = 2'b00;
-   parameter Q2 = 2'b01;
-   parameter Q3 = 2'b11;
-   parameter Q4 = 2'b10;
-
-   parameter going_empty = 1'b0;
-   parameter going_full  = 1'b1;
-   
-   input [N:0]  wptr, rptr;   
-   output reg	fifo_empty;
-   output       fifo_full;
